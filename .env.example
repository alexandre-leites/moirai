# Moirai stack configuration.
#
#   cp .env.example .env
#
# Every value here is the default already built into compose.yaml, so an empty
# .env -- or no .env at all -- gives you a working stack. Uncomment only what
# you want to change. Compose reads this file automatically; in Portainer, put
# the same keys under "Environment variables" on the stack form instead.

# --- What you will most likely change ---------------------------------------

# GitHub token, `repo` and `workflow` scopes. Optional: without it the stack
# still starts and the console works, but Moirai cannot read issues, clone,
# push, or open pull requests -- all of which it does as you. This one is
# deployment-wide; a project that configures its own in the console (Projects ->
# Credentials) uses that instead, which is how you reach a private repository
# that this token cannot see.
#MOIRAI_GITHUB_TOKEN=

# Encrypts per-project credentials before they are written to the database.
# Required only if you use them -- without it the stack runs normally and the
# console refuses a credential with a message naming this variable.
#
#   openssl rand -base64 32
#
# There is deliberately no default: a key shipped in this file would be public,
# and encrypting with it would be theatre. BACK IT UP. It is not derived from
# anything and is not stored anywhere else, so losing it means every stored
# credential is unreadable and has to be entered again.
#
# This covers what the orchestrator does with a credential -- issue sync, pull
# requests, merges. For a *runner* to be handed one (cloning, fetching, pushing)
# the control stream also has to be encrypted, because the value travels:
#
#   docker compose -f compose.yaml -f compose.tls.yaml up -d
#
# Without that overlay runners keep using MOIRAI_GITHUB_TOKEN below, which is
# the same credential for every project.
#MOIRAI_SECRET_KEY=

# Console sign-in. The password policy is at least 8 characters with a digit, a
# capital, a lowercase letter and a symbol; one that fails it stops the
# orchestrator from starting, which Compose can only report as an unhealthy
# container. Only applied when the database is first created.
#MOIRAI_ADMIN_USERNAME=admin
#MOIRAI_ADMIN_PASSWORD=Moirai-Local-1

# Host port for the console. Nothing else is published -- nginx proxies /api/
# to the API over an internal network.
#MOIRAI_WEB_PORT=3000

# --- Images ------------------------------------------------------------------

# `latest` moves with every release. Pin an exact version (0.1.0) or a commit
# (sha-abc1234) for anything you need to reproduce.
#MOIRAI_IMAGE_TAG=latest
#MOIRAI_IMAGE_PREFIX=ghcr.io/alexandre-leites/moirai

# --- Secrets -----------------------------------------------------------------

# PostgreSQL password. Changing it after the first start also needs the volume
# recreated, because the database keeps the password it was initialised with.
#MOIRAI_POSTGRES_PASSWORD=moirai-local-postgres

# Bootstrap token a runner registers with once, then swaps for a persistent
# credential. The orchestrator and the runner must agree on it.
#MOIRAI_RUNNER_TOKEN=moirai-local-runner-registration-token

# --- Runner ------------------------------------------------------------------

#MOIRAI_RUNNER_NAME=runner-1
#MOIRAI_RUNNER_LABELS=linux
#MOIRAI_RUNNER_CAPACITY=1
#MOIRAI_RUNNER_CPUS=2
#MOIRAI_RUNNER_MEMORY=4g

# Arguments passed to the coding agent.
#MOIRAI_AGENT_ARGUMENTS=--model,opencode/deepseek-v4-flash-free,--auto

# --- Seed project ------------------------------------------------------------

# Created when the database is empty and no project of this name exists. Set the
# name to an empty value to turn seeding off entirely.
#MOIRAI_SEED_PROJECT_NAME=demo
#MOIRAI_SEED_PROJECT_REPOSITORY_URL=
#MOIRAI_SEED_ISSUE_TITLE=
#MOIRAI_SEED_ISSUE_BODY=

# --- Behind TLS --------------------------------------------------------------

# Set to true once the console is served over HTTPS, so the session cookie is
# marked Secure. Leave false for plain HTTP or the browser discards it.
#MOIRAI_COOKIE_SECURE=false
