# Required: the raw registration token the runner presents to the orchestrator, and
# the token the orchestrator seeds on first boot. Generate one yourself, e.g.:
#   openssl rand -hex 32
# There is no default — the orchestrator refuses to seed a registration token, and the
# runner will fail to register, until this is set.
RUNNER_REGISTRATION_TOKEN=

# Admin user created on fresh database (password comes from secrets/initial_admin_password)
LOOP_INITIAL_ADMIN_USERNAME=admin

# secrets/ must also contain:
#   postgres_password       - postgres superuser password
#   database_url             - orchestrator's Postgres connection string
#   initial_admin_password   - password for LOOP_INITIAL_ADMIN_USERNAME above
#   github_token             - a `gh`-compatible GitHub token (repo, workflow scopes)

# Seed project created on fresh database
LOOP_SEED_PROJECT_NAME=demo
LOOP_SEED_PROJECT_REPOSITORY_URL=https://github.com/example/demo.git

# Labels for the seed registration token (comma-separated)
LOOP_SEED_TOKEN_LABELS=linux

# Seed issue created alongside the seed project (optional)
LOOP_SEED_ISSUE_TITLE=
LOOP_SEED_ISSUE_BODY=

# Runner configuration
LOOP_RUNNER_NAME=runner-1
LOOP_RUNNER_LABELS=linux
# Number of executions this runner works on concurrently (different projects only)
LOOP_RUNNER_CAPACITY=1
