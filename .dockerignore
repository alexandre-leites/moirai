# Root build context serves API, runner, and orchestrator builds.
.git/
.github/
.claude/
aidocs/
docs/
tasks/
scripts/
schemas/
proto/

# Never send credentials or local configuration to the daemon. Nothing copies
# these, but a build context is not a place to find out.
secrets/
.env
.env.*

**/node_modules/
**/dist/
**/__pycache__/
**/.venv/
**/venv/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
web/
*.md
